{
	"id": "fullerene",
	"name": "Fullerene",
	"description": "Fullerene layout on an ANSI keyboard: https://sobh.github.io/fullerene/",
	"version": 1,
	"keys": {
		"Digit1": {
			"default": {
				"base": "1",
				"shift": "!"
			}
		},
		"Digit2": {
			"default": {
				"base": "2",
				"shift": "@"
			}
		},
		"Digit3": {
			"default": {
				"base": "3",
				"shift": "#"
			}
		},
		"Digit4": {
			"default": {
				"base": "4",
				"shift": "$"
			}
		},
		"Digit5": {
			"default": {
				"base": "5",
				"shift": "%"
			}
		},
		"Digit6": {
			"default": {
				"base": "6",
				"shift": "^"
			}
		},
		"Digit7": {
			"default": {
				"base": "7",
				"shift": "&"
			}
		},
		"Digit8": {
			"default": {
				"base": "8",
				"shift": "*"
			}
		},
		"Digit9": {
			"default": {
				"base": "9",
				"shift": "("
			}
		},
		"Digit0": {
			"default": {
				"base": "0",
				"shift": ")"
			}
		},
		"KeyA": {
			"default": {
				"base": "c",
				"shift": "C"
			}
		},
		"KeyB": {
			"default": {
				"base": "x",
				"shift": "X"
			}
		},
		"KeyC": {
			"default": {
				"base": "m",
				"shift": "M"
			}
		},
		"KeyD": {
			"default": {
				"base": "t",
				"shift": "T"
			}
		},
		"KeyE": {
			"default": {
				"base": "d",
				"shift": "D"
			}
		},
		"KeyF": {
			"default": {
				"base": "n",
				"shift": "N"
			}
		},
		"KeyG": {
			"default": {
				"base": "w",
				"shift": "W"
			}
		},
		"KeyH": {
			"default": {
				"base": "b",
				"shift": "B"
			}
		},
		"KeyI": {
			"default": {
				"base": "o",
				"shift": "O"
			}
		},
		"KeyJ": {
			"default": {
				"base": "h",
				"shift": "H"
			}
		},
		"KeyK": {
			"default": {
				"base": "a",
				"shift": "A"
			}
		},
		"KeyL": {
			"default": {
				"base": "e",
				"shift": "E"
			}
		},
		"KeyM": {
			"default": {
				"base": "p",
				"shift": "P"
			}
		},
		"KeyN": {
			"default": {
				"base": ".",
				"shift": ">"
			}
		},
		"KeyO": {
			"default": {
				"base": "u",
				"shift": "U"
			}
		},
		"KeyP": {
			"default": {
				"base": ";",
				"shift": ":"
			}
		},
		"KeyQ": {
			"default": {
				"base": "q",
				"shift": "Q"
			}
		},
		"KeyR": {
			"default": {
				"base": "l",
				"shift": "L"
			}
		},
		"KeyS": {
			"default": {
				"base": "s",
				"shift": "S"
			}
		},
		"KeyT": {
			"default": {
				"base": "j",
				"shift": "J"
			}
		},
		"KeyU": {
			"default": {
				"base": "f",
				"shift": "F"
			}
		},
		"KeyV": {
			"default": {
				"base": "r",
				"shift": "R"
			}
		},
		"KeyW": {
			"default": {
				"base": "v",
				"shift": "V"
			}
		},
		"KeyX": {
			"default": {
				"base": "g",
				"shift": "G"
			}
		},
		"KeyY": {
			"default": {
				"base": "k",
				"shift": "K"
			}
		},
		"KeyZ": {
			"default": {
				"base": "y",
				"shift": "Y"
			}
		},
		"Minus": {
			"default": {
				"base": "[",
				"shift": "{"
			}
		},
		"Equal": {
			"default": {
				"base": "]",
				"shift": "}"
			}
		},
		"BracketLeft": {
			"default": {
				"base": "z",
				"shift": "Z"
			}
		},
		"BracketRight": {
			"default": {
				"base": "=",
				"shift": "+"
			}
		},
		"Backslash": {
			"default": {
				"base": "\\",
				"shift": "|"
			}
		},
		"IntlBackslash": {
			"default": {}
		},
		"Semicolon": {
			"default": {
				"base": "i",
				"shift": "I"
			}
		},
		"Backquote": {
			"default": {
				"base": "`",
				"shift": "~"
			}
		},
		"Quote": {
			"default": {
				"base": "'",
				"shift": "\""
			}
		},
		"Comma": {
			"default": {
				"base": ",",
				"shift": "<"
			}
		},
		"Period": {
			"default": {
				"base": "/",
				"shift": "?"
			}
		},
		"Slash": {
			"default": {
				"base": "-",
				"shift": "_"
			}
		},
		"Space": {
			"default": {
				"base": " "
			}
		}
	}
}